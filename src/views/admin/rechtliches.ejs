<%- include('../partials/header', { titel }) %>
<h1>Rechtliches</h1>
<% if (erfolg) { %><p class="meldung meldung-erfolg"><%= erfolg %></p><% } %>
<% if (fehler) { %><p class="meldung meldung-fehler"><%= fehler %></p><% } %>
<p class="text-schwach">Diese Texte erscheinen öffentlich (ohne Anmeldung) unter <a href="/rechtliches" target="_blank" rel="noopener">/rechtliches</a>. Es handelt sich um editierbare Vorlagen - keine Rechtsberatung, keine Prüfung durch diese Anwendung. Platzhalter wie "Max Mustermann" bitte vor dem produktiven Betrieb durch echte Angaben ersetzen.</p>

<div class="karte">
  <form method="post" action="/admin/rechtliches" class="formular" style="max-width: 100%;">
    <label>Impressum
      <textarea name="impressum" rows="10"><%= impressum %></textarea>
    </label>
    <label>Datenschutz
      <textarea name="datenschutz" rows="16"><%= datenschutz %></textarea>
    </label>
    <label>Weitere Hinweise (optional, bleibt leer ausblendbar)
      <textarea name="sonstiges" rows="6"><%= sonstiges %></textarea>
    </label>
    <button type="submit">Speichern</button>
  </form>
</div>
<%- include('../partials/footer') %>
